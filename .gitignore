# Maven 编译文件
**/target/
**/build/
*.class
*.jar
*.war
*.ear

# IDEA 开发工具
**/.idea/
*.iml
*.ipr
*.iws

# Eclipse
.classpath
.project
.settings/

# VS Code
.vscode/

# 前端 Node.js
**/node_modules/
**/dist/
**/.vite/
**/coverage/

# 日志
*.log
logs/
**/logs/

# 临时文件
*.tmp
*.temp
*.bak
*.swp
*~

# 操作系统文件
.DS_Store
Thumbs.db
desktop.ini

# Docker 运行数据
docker/data/
**/docker/data/

# 环境敏感配置
.env
.env.*
!.env.example

# Python 缓存
__pycache__/
*.pyc

# Maven 本地辅助文件
.mvn/timing.properties

# 压缩包
*.zip
*.rar
*.7z
*.tar
*.gz
